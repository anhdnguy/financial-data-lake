# ─── PostgreSQL (metadata store) ────────────────────────────────────────────
DB_USER='your_db_user'
DB_PASSWORD='change_me'
DB_DB='ohlcv'
# Container-to-container alias on shared-network. For host-side runs use 'localhost'.
DB_HOSTNAME='ohlcv-db'

# ─── Redis (Schwab token cache + SET NX refresh lock) ───────────────────────
# Dedicated container alias on shared-network. For host-side runs use 'localhost'.
REDIS_HOST='ohlcv-redis'
REDIS_PORT='6379'

# ─── Schwab API (market data source) ────────────────────────────────────────
SCHWAB_CLIENT_ID=''
SCHWAB_CLIENT_SECRET=''
SCHWAB_BASE_URL='https://api.schwabapi.com'
# Rate limiter: average call rate (headroom under ~120/min consensus) and max
# burst (1 = perfectly smooth drip, no spike possible).
SCHWAB_CALLS_PER_MIN='109'
SCHWAB_LIMITER_CAPACITY='1'

# ─── S3 / Delta Lake (price store; LocalStack in dev) ───────────────────────
# Container reach: http://localstack:4566 — host reach: http://localhost:4566
S3_ENDPOINT_URL='http://localstack:4566'
AWS_ACCESS_KEY_ID='test'
AWS_SECRET_ACCESS_KEY='test'
AWS_REGION='us-east-1'
DELTA_TABLE_URI='s3://ohlcv/prices'

# ─── Airflow (dedicated single-project stack, LocalExecutor) ────────────────
# Match the container user to the host user (`id -u`) so bind-mounted logs
# stay writable on Linux.
AIRFLOW_UID=1000
# Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=''
# Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=''
# Web UI admin login (http://localhost:8080).
_AIRFLOW_WWW_USER_USERNAME='airflow'
_AIRFLOW_WWW_USER_PASSWORD='airflow'
